# Local (Ollama) or Bedrock; switch without code changes
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=bge-m3
# PhysioNet DUA: never send MIMIC text to third-party tracing
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.deepseek.r1-v1:0

# MIMIC raw data root (read-only); each machine sets its own path
MIMIC_RAW_DIR=E:/project data/AgentResearch/raw
