# Raw / derived MIMIC data stays local (PhysioNet DUA): ignore everything under the top-level data/ ...
/data/*
# ... except the study sample folder. It holds MIMIC note text and is tracked only because this repo
# is private and every collaborator is PhysioNet-credentialed with a signed DUA. Do not make the repo public.
!/data/sample/

derived/
.venv/
.env
traces/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
chroma_db/
