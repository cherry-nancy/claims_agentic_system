   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "FINDINGS:",
   "provenance": "discharge:note_id=16326503-DS-22:chars=4751-4760",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s41",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Heart size and cardiomediastinal contours are normal.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=4763-4816",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s42",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Lungs are \nclear without focal consolidation, pleural effusion, or \npneumothorax.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=4817-4898",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s43",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "No acute osseous abnormalities.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=4900-4931",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s44",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "No free air below \nthe right hemidiaphragm.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=4932-4975",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s45",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "IMPRESSION:",
   "provenance": "discharge:note_id=16326503-DS-22:chars=4980-4991",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s46",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "No acute findings.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=4994-5012",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s47",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "No evidence of cardiomegaly or pleural \neffusion",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5014-5062",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s48",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "CT Abd/Pelvis ___",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5065-5082",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s49",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "FINDINGS:",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5083-5092",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s50",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Partially imaged lung bases are clear.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5095-5133",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s51",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There is no pleural \neffusion.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5134-5164",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s52",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "CT abdomen: A 3 mm hypodensity at the dome of the liver is too \nsmall to \ncharacterize (3:6).",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5169-5262",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s53",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The liver enhances homogeneously without \nconcerning \nlesions or biliary dilatation.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5263-5347",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s54",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Gallbladder, spleen, pancreas, \nand bilateral adrenal glands are within normal limits.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5348-5434",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s55",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Kidneys \nenhance and excrete symmetrically.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5435-5478",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s57",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There is no hydronephrosis.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5584-5611",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s58",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Wall thickening at the gastroesophageal junction corresponds to \nan FDG avid lesion seen on recent PET and known adenocarcinoma.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5616-5744",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s59",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The stomach is largely decompressed and difficult to evaluate.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5746-5808",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s60",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Nondilated loops of small bowel are within normal limits.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5810-5867",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s61",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Colon \nis notable for extensive diverticulosis without diverticulitis.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5868-5938",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s62",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There is no mesenteric or retroperitoneal lymphadenopathy.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5940-5998",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s63",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There \nis no intra-abdominal free air or fluid.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=5999-6046",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s64",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Abdominal aorta \ndemonstrates moderate atherosclerosis but no aneurysmal \ndilatation.",
   "provenance": "discharge:note_id=16326503-DS-22:chars=6047-6132",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s65",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
