   "needs": []
  },
  {
   "ref_id": "DS:HC:s3",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "The patient was taken to the \noperating room on ___ for R TFN, which the patient tolerated \nwell (for full details please see the separately dictated \noperative report).",
   "provenance": "discharge:note_id=11150340-DS-8:chars=5247-5416",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s4",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "The patient was taken from the OR to the PACU \nin stable condition and after recovery from anesthesia was \ntransferred to the floor.",
   "provenance": "discharge:note_id=11150340-DS-8:chars=5417-5549",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s5",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "The patient was initially given IV \nfluids and IV pain medications, and progressed to a regular diet \nand oral medications by POD#1.",
   "provenance": "discharge:note_id=11150340-DS-8:chars=5551-5683",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s6",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "The patient was given \nperioperative antibiotics and anticoagulation per routine.",
   "provenance": "discharge:note_id=11150340-DS-8:chars=5684-5765",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s7",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "She \nhad a positive UA but patient had no symptoms and urine culture \nshowed only mixed skin flora.",
