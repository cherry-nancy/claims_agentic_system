   "needs": []
  },
  {
   "ref_id": "DS:HC:s2",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "The patient was found \nto have right intertroch femur fracture and was admitted to the \northopedic surgery service.",
