   "needs": []
  },
  {
   "ref_id": "DS:HPI:s13",
   "source": "discharge_note",
   "kind": "span",
   "section": "HPI",
   "available_at": null,
   "text": "The patient\ndoes not recall feeling unilateral weakness, but admits to\nfeeling exhausted.",
