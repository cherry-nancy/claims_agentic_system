   "ref_id": "DS:HC:s1",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "Mr. ___ is a ___ yo right handed man with PMH significant for \natrial fibrillation (on apixaban), lumbar spinal stenosis and \nmild right leg weakness, who presents with new onset dysarthria, \nataxia and right sided weakness.",
   "provenance": "discharge:note_id=11081904-DS-16:chars=6569-6793",
