  },
  {
   "ref_id": "RAD:17148283-RR-22:s1",
   "source": "radiology",
   "kind": "span",
   "section": "IMPRESSION",
   "available_at": "2128-11-17T19:46:00",
   "text": "Suboptimal study due to the patient's overlying chin obscuring the left lung apex and medial right lung apex as well the patient's overlying upper extremity obscuring the left hemidiaphragm.",
   "provenance": "radiology:note_id=17148283-RR-22:chars=608-798",
   "needs": []
  },
  {
   "ref_id": "RAD:17148283-RR-22:s2",
   "source": "radiology",
   "kind": "span",
   "section": "IMPRESSION",
   "available_at": "2128-11-17T19:46:00",
   "text": "Given this, no definite acute cardiopulmonary process seen.",
   "provenance": "radiology:note_id=17148283-RR-22:chars=800-859",
   "needs": []
  },
  {
   "ref_id": "RAD:17148283-RR-23:s1",
   "source": "radiology",
   "kind": "span",
   "section": "IMPRESSION",
   "available_at": "2128-11-23T07:51:00",
   "text": "The heart remains stably enlarged favoring cardiomegaly rather than pericardial effusion.",
   "provenance": "radiology:note_id=17148283-RR-23:chars=334-423",
   "needs": []
  },
  {
   "ref_id": "RAD:17148283-RR-23:s2",
   "source": "radiology",
   "kind": "span",
   "section": "IMPRESSION",
   "available_at": "2128-11-23T07:51:00",
   "text": "Lungs are slightly low in volume with patchy opacity at the right base favoring atelectasis rather than pneumonia.",
   "provenance": "radiology:note_id=17148283-RR-23:chars=425-539",
   "needs": []
  },
  {
   "ref_id": "RAD:17148283-RR-23:s3",
   "source": "radiology",
   "kind": "span",
   "section": "IMPRESSION",
   "available_at": "2128-11-23T07:51:00",
   "text": "There is mild pulmonary venous hypertension but no pulmonary edema.",
   "provenance": "radiology:note_id=17148283-RR-23:chars=541-608",
   "needs": []
  },
  {
   "ref_id": "RAD:17148283-RR-23:s4",
   "source": "radiology",
   "kind": "span",
   "section": "IMPRESSION",
   "available_at": "2128-11-23T07:51:00",
   "text": "No pleural effusions.",
   "provenance": "radiology:note_id=17148283-RR-23:chars=610-631",
   "needs": []
  },
  {
   "ref_id": "RAD:17148283-RR-23:s5",
   "source": "radiology",
   "kind": "span",
   "section": "IMPRESSION",
   "available_at": "2128-11-23T07:51:00",
   "text": "No pneumothorax.",
   "provenance": "radiology:note_id=17148283-RR-23:chars=633-649",
   "needs": []
  },
