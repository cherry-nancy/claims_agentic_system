  },
  {
   "ref_id": "DS:HC:s5",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "Waxing and waning mental \nstatus but overall was improving (on admission was somnolent and \nnot opening eyes or answering any questions).",
