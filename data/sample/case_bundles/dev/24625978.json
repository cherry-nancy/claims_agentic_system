   "needs": []
  },
  {
   "ref_id": "DS:HC:s10",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "# Goals of care:  Discussed with HCP and daughter ___ \nconcern that despite fixing reversible causes of his worsened \nmental status he still is not eating and drinking concerning for \nprogression of his dementia.",
   "provenance": "discharge:note_id=17148283-DS-13:chars=4961-5173",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s11",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "Agreed that he would not want \nartificial nutrition or hydration in his current condition and \nto focus on comfort.",
   "provenance": "discharge:note_id=17148283-DS-13:chars=5175-5290",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s12",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "She would still like him to take his \nmedications as he tolerates, but does not want him force fed.",
