   "needs": []
  },
  {
   "ref_id": "DS:HC:s7",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "Per daughter \nhis PO intake has been decreasing over weeks.",
   "provenance": "discharge:note_id=17148283-DS-13:chars=4710-4769",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s8",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "Concern that due \nto progression of his dementia he will not be able to take \nadequate PO intake and that he likely has a very short life \nexpectancy.",
   "provenance": "discharge:note_id=17148283-DS-13:chars=4770-4920",
   "needs": []
  },
  {
   "ref_id": "DS:HC:s9",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "- Goals of care discussions as below",
