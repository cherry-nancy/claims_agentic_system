   "ref_id": "DS:HC:s15",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "Her daughter explained that she has also seemed \ndepressed with decreased appetite recently and therefore she was \nstarted on low dose mirtazapine 7.5 mg QHS to help with these \nissues on ___.",
   "provenance": "discharge:note_id=14254559-DS-24:chars=7488-7680",
   "needs": []
