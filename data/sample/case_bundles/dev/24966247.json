   "needs": []
  },
  {
   "ref_id": "DS:HC:s19",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "Differential also included infection and hypoactive \ndelirium which patient is at increased risk for given her age.",
