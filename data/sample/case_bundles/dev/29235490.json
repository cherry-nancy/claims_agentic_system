   "needs": []
  },
  {
   "ref_id": "DS:PR:s33",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "TTE ___: The left atrium is elongated.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=4969-5007",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s34",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The right atrium is \nmarkedly dilated.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5008-5046",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s35",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There is mild symmetric left ventricular \nhypertrophy.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5047-5101",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s36",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The left ventricular cavity size is normal.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5102-5145",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s37",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Due to \nsuboptimal technical quality and irregular rhythm, a focal wall \nmotion abnormality cannot be fully excluded.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5146-5263",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s38",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Overall left \nventricular systolic function is low normal (LVEF 50-55%).",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5264-5336",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s39",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The \nright ventricular cavity is mildly dilated with moderate global \nfree wall hypokinesis.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5337-5429",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s40",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "A bioprosthetic aortic valve prosthesis \nis present.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5430-5482",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s41",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The transaortic gradient is normal for this \nprosthesis.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5483-5539",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s42",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Trace aortic regurgitation is seen.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5540-5575",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s43",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The mitral valve \nleaflets are mildly thickened.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5576-5624",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s44",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There is no mitral valve \nprolapse.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5625-5660",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s45",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Moderate (2+) mitral regurgitation is seen.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5661-5704",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s46",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The \ntricuspid valve leaflets are moderately thickened and coapt \npoorly.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5705-5778",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s47",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Moderate to severe [3+] tricuspid regurgitation is seen.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5779-5835",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s48",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There is severe pulmonary artery systolic hypertension.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5837-5892",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s49",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Significant pulmonic regurgitation is seen.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5894-5937",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s50",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "The end-diastolic \npulmonic regurgitation velocity is increased suggesting \npulmonary artery diastolic hypertension.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=5938-6054",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s51",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "There is no pericardial \neffusion.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=6055-6089",
   "needs": []
  },
  {
   "ref_id": "DS:PR:s52",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "IMPRESSION: Borderline normal LV function, with subptimal \nendocardial visualiation, limiting assessment of regional \nvariation.",
