   "needs": []
  },
  {
   "ref_id": "DS:PR:s53",
   "source": "discharge_note",
   "kind": "span",
   "section": "PR",
   "available_at": null,
   "text": "Right ventricle is mildly dilated with moderate \nhypokinesis.",
   "provenance": "discharge:note_id=11609880-DS-22:chars=6221-6282",
   "needs": []
  },
  {
