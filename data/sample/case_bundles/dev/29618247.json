  },
  {
   "ref_id": "DS:HC:s14",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "1, and showed normal myocardial perfusion and normal left \nventricular cavity size and systolic function.",
