   "ref_id": "DS:HC:s15",
   "source": "discharge_note",
   "kind": "span",
   "section": "HC",
   "available_at": null,
   "text": "The \npharmacologic stress test was performed on day 2 demonstrated no \nangina symptoms or EKG changes.",
